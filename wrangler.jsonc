{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "app-nova",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "4e95bcdf-30f6-4024-8461-33b552a8ce31","database_name": "app-nova" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "9818e2e617dd439aacf2702fcc36c294" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
